{% comment %}
  F-31 Cart Goal Tracker (Pro, app embed). Multi-tier progress bar, e.g.
  free shipping at $50, free gift at $100 -- the Pro upgrade of the
  single-tier Free Shipping Bar.

  Settings resolve from the `vantora` shop metafield first (written when
  the merchant saves this tool in the admin GUI), falling back to this
  block's Theme Editor settings if that metafield doesn't exist yet. See
  sticky-add-to-cart.liquid for why this is a whole-object fallback rather
  than merged field-by-field.
{% endcomment %}
{% assign v = shop.metafields.vantora.goal_tracker.value %}
{% if v %}
  {% assign position = v.position | default: 'cart' %}
  {% assign tier_1_threshold = v.tier_1_threshold %}
  {% assign tier_1_label = v.tier_1_label %}
  {% assign tier_2_threshold = v.tier_2_threshold %}
  {% assign tier_2_label = v.tier_2_label %}
  {% assign tier_3_threshold = v.tier_3_threshold %}
  {% assign tier_3_label = v.tier_3_label %}
  {% assign background_color = v.background_color %}
  {% assign progress_color = v.progress_color %}
  {% assign text_color = v.text_color %}
{% else %}
  {% assign position = block.settings.position | default: 'cart' %}
  {% assign tier_1_threshold = block.settings.tier_1_threshold %}
  {% assign tier_1_label = block.settings.tier_1_label %}
  {% assign tier_2_threshold = block.settings.tier_2_threshold %}
  {% assign tier_2_label = block.settings.tier_2_label %}
  {% assign tier_3_threshold = block.settings.tier_3_threshold %}
  {% assign tier_3_label = block.settings.tier_3_label %}
  {% assign background_color = block.settings.background_color %}
  {% assign progress_color = block.settings.progress_color %}
  {% assign text_color = block.settings.text_color %}
{% endif %}

{% comment %}
  "Cart page" is reliably known at render time (template == 'cart'), so that
  mode is gated server-side. "Cart drawer" can be opened from any page in
  most themes, and this block can't reach inside the theme's own drawer
  markup -- so that mode renders as a floating widget instead, which is the
  closest a body-level app embed can get without theme-specific hooks.
{% endcomment %}
{% if position == 'cart' and template != 'cart' %}
  {% comment %} Not on the cart page -- render nothing. {% endcomment %}
{% else %}
<div
  id="vantora-goal-tracker"
  class="vantora-goal-tracker"
  data-tiers='[
    {% if tier_1_threshold > 0 %}{"threshold": {{ tier_1_threshold }}, "label": {{ tier_1_label | json }}}{% endif %}
    {% if tier_2_threshold > 0 %},{"threshold": {{ tier_2_threshold }}, "label": {{ tier_2_label | json }}}{% endif %}
    {% if tier_3_threshold > 0 %},{"threshold": {{ tier_3_threshold }}, "label": {{ tier_3_label | json }}}{% endif %}
  ]'
  style="--vantora-goal-bg: {{ background_color }}; --vantora-goal-fill: {{ progress_color }}; --vantora-goal-text: {{ text_color }};"
  {{ block.shopify_attributes }}
>
  <p class="vantora-goal-tracker__message"></p>
  <div class="vantora-goal-tracker__track">
    <div class="vantora-goal-tracker__fill" style="width: 0%"></div>
    <div class="vantora-goal-tracker__markers"></div>
  </div>
</div>

<style>
  .vantora-goal-tracker { padding: 10px 16px; background: var(--vantora-goal-bg, #f4f4f4); color: var(--vantora-goal-text, #111); text-align: center; font-size: 14px; }
  .vantora-goal-tracker__message { margin: 0 0 8px; }
  .vantora-goal-tracker__track { position: relative; height: 6px; border-radius: 3px; background: rgba(0,0,0,.1); }
  .vantora-goal-tracker__fill { height: 100%; border-radius: 3px; background: var(--vantora-goal-fill, #1a7f37); transition: width .3s ease; }
  .vantora-goal-tracker__markers { position: absolute; inset: 0; }
  .vantora-goal-tracker__marker { position: absolute; top: -3px; width: 2px; height: 12px; background: rgba(0,0,0,.25); }
</style>

<script src="{{ 'vantora-analytics.js' | asset_url }}" defer></script>
<script>
  (function () {
    var el = document.getElementById('vantora-goal-tracker');
    if (!el) return;

    var tiers;
    try {
      tiers = JSON.parse(el.dataset.tiers).sort(function (a, b) { return a.threshold - b.threshold; });
    } catch (e) {
      tiers = [];
    }
    if (!tiers.length) { el.hidden = true; return; }

    if (window.VantoraAnalytics) VantoraAnalytics.report('impression', 'goal_tracker');

    var maxThreshold = tiers[tiers.length - 1].threshold;

    function money(cents) {
      return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD' });
    }

    function render(cartTotalCents) {
      var cartTotal = cartTotalCents / 100;
      var fill = el.querySelector('.vantora-goal-tracker__fill');
      var message = el.querySelector('.vantora-goal-tracker__message');
      var markers = el.querySelector('.vantora-goal-tracker__markers');

      fill.style.width = Math.min(100, (cartTotal / maxThreshold) * 100) + '%';

      markers.innerHTML = '';
      tiers.forEach(function (tier) {
        var marker = document.createElement('div');
        marker.className = 'vantora-goal-tracker__marker';
        marker.style.left = Math.min(100, (tier.threshold / maxThreshold) * 100) + '%';
        markers.appendChild(marker);
      });

      var nextTier = tiers.find(function (t) { return cartTotal < t.threshold; });
      if (nextTier) {
        var remaining = money((nextTier.threshold - cartTotal) * 100);
        message.textContent = 'Add ' + remaining + ' more to unlock: ' + nextTier.label;
      } else {
        message.textContent = tiers[tiers.length - 1].label + ' unlocked!';
      }
    }

    function refresh() {
      fetch('/cart.js')
        .then(function (res) { return res.json(); })
        .then(function (cart) { render(cart.total_price); })
        .catch(function (err) { console.error('Vantora goal tracker refresh failed', err); });
    }

    refresh();
    document.addEventListener('vantora:cart-updated', refresh);
    document.addEventListener('cart:refresh', refresh);
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Vantora: Goal Tracker",
  "target": "body",
  "settings": [
    { "type": "number", "id": "tier_1_threshold", "label": "Tier 1 threshold", "default": 50 },
    { "type": "text", "id": "tier_1_label", "label": "Tier 1 label", "default": "Free shipping" },
    { "type": "number", "id": "tier_2_threshold", "label": "Tier 2 threshold", "default": 100 },
    { "type": "text", "id": "tier_2_label", "label": "Tier 2 label", "default": "Free gift" },
    { "type": "number", "id": "tier_3_threshold", "label": "Tier 3 threshold (optional)", "default": 0 },
    { "type": "text", "id": "tier_3_label", "label": "Tier 3 label" },
    { "type": "select", "id": "position", "label": "Where it shows", "default": "cart",
      "options": [ { "value": "cart", "label": "Cart page only" }, { "value": "cart_drawer", "label": "Floating (cart drawer)" } ] },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f4f4f4" },
    { "type": "color", "id": "progress_color", "label": "Progress color", "default": "#1a7f37" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" }
  ]
}
{% endschema %}
