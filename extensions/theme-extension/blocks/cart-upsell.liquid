{% comment %}
  F-28 Cart Upsell (Pro, app embed). Renders recommended add-ons in the
  cart drawer/page. Picks are configured in the admin (manual or
  AI-suggested) and reach this block two ways: the picks themselves come
  live from the app's public recommendations endpoint (keyed by the
  current cart's product IDs, so they stay fresh without a theme deploy);
  heading/appearance come from the `vantora` shop metafield (written by
  ThemeSettingsSyncService), falling back to this block's Theme Editor
  settings -- see sticky-add-to-cart.liquid for why that's a whole-object
  fallback rather than merged field-by-field.
{% endcomment %}
{% assign v = shop.metafields.vantora.cart_upsell.value %}
{% if v %}
  {% assign heading = v.heading %}
  {% assign max_items = v.max_items %}
  {% assign accent_color = v.accent_color %}
{% else %}
  {% assign heading = block.settings.heading %}
  {% assign max_items = block.settings.max_items %}
  {% assign accent_color = block.settings.accent_color %}
{% endif %}

<div
  id="vantora-cart-upsell"
  class="vantora-cart-upsell"
  data-max-items="{{ max_items }}"
  style="--vantora-upsell-accent: {{ accent_color }};"
  {{ block.shopify_attributes }}
>
  <p class="vantora-cart-upsell__heading">{{ heading }}</p>
  <div class="vantora-cart-upsell__items" aria-live="polite"></div>
</div>

<template id="vantora-cart-upsell-item-template">
  <div class="vantora-cart-upsell__item">
    <img class="vantora-cart-upsell__image" alt="" width="48" height="48" loading="lazy">
    <div class="vantora-cart-upsell__info">
      <span class="vantora-cart-upsell__title"></span>
      <span class="vantora-cart-upsell__price"></span>
    </div>
    <button type="button" class="vantora-cart-upsell__add">Add</button>
  </div>
</template>

<style>
  .vantora-cart-upsell { padding: 12px 0; }
  .vantora-cart-upsell__heading { font-weight: 600; margin: 0 0 8px; }
  .vantora-cart-upsell__items { display: flex; flex-direction: column; gap: 8px; }
  .vantora-cart-upsell__item { display: flex; align-items: center; gap: 10px; }
  .vantora-cart-upsell__image { border-radius: 4px; object-fit: cover; }
  .vantora-cart-upsell__info { flex: 1; display: flex; flex-direction: column; font-size: 13px; }
  .vantora-cart-upsell__add { background: var(--vantora-upsell-accent, #111); color: #fff; border: 0; border-radius: 6px; padding: 6px 12px; cursor: pointer; font-size: 13px; }
</style>

<script src="{{ 'vantora-analytics.js' | asset_url }}" defer></script>
<script>
  (function () {
    var root = document.getElementById('vantora-cart-upsell');
    if (!root) return;

    var maxItems = parseInt(root.dataset.maxItems, 10) || 3;
    var template = document.getElementById('vantora-cart-upsell-item-template');
    var container = root.querySelector('.vantora-cart-upsell__items');

    // Hidden until there's something to show -- the heading otherwise
    // renders unconditionally (Liquid has no way to know at page-load
    // time whether the recommendations call will return anything).
    root.hidden = true;

    function render(recommendations) {
      container.innerHTML = '';
      var shown = recommendations.slice(0, maxItems);
      root.hidden = shown.length === 0;
      if (shown.length && window.VantoraAnalytics) VantoraAnalytics.report('impression', 'cart_upsell');

      shown.forEach(function (product) {
        var node = template.content.cloneNode(true);
        var img = node.querySelector('.vantora-cart-upsell__image');
        img.src = product.image || '';
        img.alt = product.title;
        node.querySelector('.vantora-cart-upsell__title').textContent = product.title;
        node.querySelector('.vantora-cart-upsell__price').textContent = product.price;
        node.querySelector('.vantora-cart-upsell__add').addEventListener('click', function () {
          if (window.VantoraAnalytics) VantoraAnalytics.report('click', 'cart_upsell');
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: product.variant_id, quantity: 1, properties: { _vantora_source: 'cart_upsell' } }),
          }).then(function () {
            document.dispatchEvent(new CustomEvent('vantora:cart-updated'));
            document.dispatchEvent(new CustomEvent('cart:refresh'));
            refresh();
          });
        });
        container.appendChild(node);
      });
    }

    function refresh() {
      fetch('/cart.js')
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          var productIds = cart.items.map(function (item) { return item.product_id; });
          return fetch('/apps/vantora/recommendations?surface=cart&product_ids=' + productIds.join(','));
        })
        .then(function (res) { return res.ok ? res.json() : { recommendations: [] }; })
        .then(function (data) { render(data.recommendations || []); })
        .catch(function (err) { console.error('Vantora cart upsell failed to load recommendations', err); });
    }

    refresh();
    document.addEventListener('vantora:cart-updated', refresh);
    document.addEventListener('cart:refresh', refresh);
  })();
</script>

{% schema %}
{
  "name": "Vantora: Cart Upsell",
  "target": "body",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "range", "id": "max_items", "label": "Max items shown", "min": 1, "max": 6, "default": 3 },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#111111" }
  ]
}
{% endschema %}
