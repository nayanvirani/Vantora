{% comment %}
  F-12 Free Shipping Bar (app embed). Reads the live cart total client-side
  via /cart.js so the progress bar stays accurate across AJAX cart updates.

  Settings resolve from the `vantora` shop metafield first (written when
  the merchant saves this tool in the admin GUI), falling back to this
  block's Theme Editor settings if that metafield doesn't exist yet. See
  sticky-add-to-cart.liquid for why this is a whole-object fallback rather
  than merged field-by-field.
{% endcomment %}
{% assign v = shop.metafields.vantora.shipping_bar.value %}
{% if v %}
  {% assign threshold = v.threshold %}
  {% assign position = v.position %}
  {% assign progress_message = v.progress_message %}
  {% assign success_message = v.success_message %}
  {% assign background_color = v.background_color %}
  {% assign progress_color = v.progress_color %}
  {% assign text_color = v.text_color %}
{% else %}
  {% assign threshold = block.settings.threshold %}
  {% assign position = block.settings.position %}
  {% assign progress_message = block.settings.progress_message %}
  {% assign success_message = block.settings.success_message %}
  {% assign background_color = block.settings.background_color %}
  {% assign progress_color = block.settings.progress_color %}
  {% assign text_color = block.settings.text_color %}
{% endif %}

{% comment %}
  "top" is a sitewide banner by design. "cart" is gated to the cart page,
  same as cart-goal-tracker.liquid. "cart_drawer" tries to physically move
  into the theme's own drawer markup (see the script below) -- verified
  against this store's actual theme (Dawn): `#CartDrawer .drawer__inner`.
  Not a documented cross-theme standard, so it floats in place on any
  other theme instead.
{% endcomment %}
{% if position == 'cart' and template != 'cart' %}
  {% comment %} Not on the cart page -- render nothing. {% endcomment %}
{% else %}
<div
  id="vantora-shipping-bar"
  class="vantora-shipping-bar vantora-shipping-bar--{{ position }}"
  data-threshold-cents="{{ threshold | times: 100 | round }}"
  style="--vantora-bar-bg: {{ background_color }}; --vantora-bar-fill: {{ progress_color }}; --vantora-bar-text: {{ text_color }};"
  {{ block.shopify_attributes }}
>
  <p class="vantora-shipping-bar__message"></p>
  <div class="vantora-shipping-bar__track">
    <div class="vantora-shipping-bar__fill" style="width: 0%"></div>
  </div>
</div>

<style>
  .vantora-shipping-bar { padding: 10px 16px; background: var(--vantora-bar-bg, #f4f4f4); color: var(--vantora-bar-text, #111); text-align: center; font-size: 14px; }
  .vantora-shipping-bar__message { margin: 0 0 6px; }
  .vantora-shipping-bar__track { height: 6px; border-radius: 3px; background: rgba(0,0,0,.1); overflow: hidden; }
  .vantora-shipping-bar__fill { height: 100%; background: var(--vantora-bar-fill, #1a7f37); transition: width .3s ease; }
</style>

<script src="{{ 'vantora-analytics.js' | asset_url }}" defer></script>
<script>
  (function () {
    var el = document.getElementById('vantora-shipping-bar');
    if (!el) return;

    if (el.classList.contains('vantora-shipping-bar--cart_drawer')) {
      // Best-effort: verified Dawn structure only (see comment above) --
      // falls back to floating in place on any other theme.
      var drawerInner = document.querySelector('#CartDrawer .drawer__inner');
      if (drawerInner) drawerInner.insertBefore(el, drawerInner.firstChild);
    }

    if (window.VantoraAnalytics) VantoraAnalytics.report('impression', 'shipping_bar');

    var thresholdCents = parseInt(el.dataset.thresholdCents, 10) || 0;
    var progressTemplate = {{ progress_message | json }};
    var successTemplate = {{ success_message | json }};

    function money(cents) {
      return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD' });
    }

    function render(cartTotal) {
      var fill = el.querySelector('.vantora-shipping-bar__fill');
      var message = el.querySelector('.vantora-shipping-bar__message');
      var pct = thresholdCents > 0 ? Math.min(100, (cartTotal / thresholdCents) * 100) : 100;
      fill.style.width = pct + '%';

      if (cartTotal >= thresholdCents) {
        message.textContent = successTemplate;
      } else {
        var remaining = money(thresholdCents - cartTotal);
        message.textContent = progressTemplate.replace('%%AMOUNT%%', remaining);
      }
    }

    function refresh() {
      fetch('/cart.js')
        .then(function (res) { return res.json(); })
        .then(function (cart) { render(cart.total_price); })
        .catch(function (err) { console.error('Vantora shipping bar refresh failed', err); });
    }

    refresh();
    document.addEventListener('vantora:cart-updated', refresh);
    document.addEventListener('cart:refresh', refresh);
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Vantora: Shipping Bar",
  "target": "body",
  "settings": [
    { "type": "number", "id": "threshold", "label": "Free shipping threshold", "default": 50 },
    { "type": "select", "id": "position", "label": "Position", "default": "cart",
      "options": [ { "value": "cart", "label": "Cart page" }, { "value": "cart_drawer", "label": "Cart drawer" }, { "value": "top", "label": "Page top (every page)" } ] },
    { "type": "text", "id": "progress_message", "label": "Progress message", "default": "Add %%AMOUNT%% more for free shipping!" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You've unlocked free shipping!" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f4f4f4" },
    { "type": "color", "id": "progress_color", "label": "Progress color", "default": "#1a7f37" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" }
  ]
}
{% endschema %}
