{% comment %}
  F-29 Frequently Bought Together (Pro, app block). Product-page block that
  adds a configured set with one click. Set is looked up by the current
  product's ID through the app proxy so it stays editable from the admin
  without a theme deploy.
{% endcomment %}
{% if product %}
  <div
    id="vantora-fbt"
    class="vantora-fbt"
    data-product-id="{{ product.id }}"
    style="--vantora-fbt-accent: {{ block.settings.accent_color }};"
    {{ block.shopify_attributes }}
  >
    <p class="vantora-fbt__heading">{{ block.settings.heading }}</p>
    <div class="vantora-fbt__items"></div>
    <div class="vantora-fbt__footer" hidden>
      <span class="vantora-fbt__total"></span>
      <button type="button" class="vantora-fbt__add">{{ block.settings.button_text | default: 'Add all to cart' }}</button>
    </div>
  </div>

  <style>
    .vantora-fbt { padding: 16px 0; }
    .vantora-fbt__heading { font-weight: 600; margin: 0 0 10px; }
    .vantora-fbt__items { display: flex; flex-wrap: wrap; gap: 12px; }
    .vantora-fbt__item { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 88px; font-size: 12px; text-align: center; }
    .vantora-fbt__item img { width: 72px; height: 72px; object-fit: cover; border-radius: 6px; }
    .vantora-fbt__footer { margin-top: 12px; display: flex; align-items: center; gap: 12px; }
    .vantora-fbt__add { background: var(--vantora-fbt-accent, #111); color: #fff; border: 0; border-radius: 6px; padding: 8px 16px; cursor: pointer; }
  </style>

  <script src="{{ 'vantora-analytics.js' | asset_url }}" defer></script>
  <script src="{{ 'vantora-cart.js' | asset_url }}" defer></script>
  <script>
    (function () {
      var root = document.getElementById('vantora-fbt');
      if (!root) return;

      var itemsEl = root.querySelector('.vantora-fbt__items');
      var footerEl = root.querySelector('.vantora-fbt__footer');
      var totalEl = root.querySelector('.vantora-fbt__total');

      fetch('/apps/vantora/fbt?product_id=' + encodeURIComponent(root.dataset.productId))
        .then(function (res) { return res.ok ? res.json() : { set: null }; })
        .then(function (data) {
          if (!data.set || !data.set.picks || !data.set.picks.length) {
            root.hidden = true;
            return;
          }

          var picks = data.set.picks;
          var total = picks.reduce(function (sum, p) { return sum + (parseFloat(p.price) || 0); }, 0);
          totalEl.textContent = 'Total: ' + total.toFixed(2);

          picks.forEach(function (pick) {
            var el = document.createElement('div');
            el.className = 'vantora-fbt__item';
            el.innerHTML = '<img src="' + (pick.image || '') + '" alt="">' +
              '<span>' + pick.title + '</span><span>' + pick.price + '</span>';
            itemsEl.appendChild(el);
          });

          footerEl.hidden = false;
          if (window.VantoraAnalytics) VantoraAnalytics.report('impression', 'fbt');

          footerEl.querySelector('.vantora-fbt__add').addEventListener('click', function () {
            if (window.VantoraAnalytics) VantoraAnalytics.report('click', 'fbt');
            var items = picks.map(function (p) { return { id: p.variant_id, quantity: 1, properties: { _vantora_source: 'fbt' } }; });
            VantoraCart.add({ items: items }).catch(function (err) { console.error('Vantora FBT add failed', err); });
          });
        })
        .catch(function (err) { console.error('Vantora FBT failed to load', err); });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Vantora: Buy Together",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently bought together" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add all to cart" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#111111" }
  ]
}
{% endschema %}
