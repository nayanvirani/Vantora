{% comment %}
  F-14 Product FAQ (app block). Accordion Q&A with FAQPage schema markup
  for SEO.

  Content is configured entirely in the Vantora app (Storefront > Product
  FAQ), not here -- a merchant found having the same questions/answers
  editable in both the app AND the Theme Editor confusing (and the Theme
  Editor copy never actually reached the storefront anyway, since the
  metafield always wins once set). This block only reads the `vantora`
  metafield now: product-specific first (targeted to specific products in
  the app), falling back to the shop-wide one (untargeted / applies
  everywhere). If neither exists yet -- the merchant hasn't configured
  this in the app -- it renders nothing rather than placeholder content.
{% endcomment %}
{% assign source = shop.metafields.vantora.faq.value %}
{% if product %}
  {% assign source = product.metafields.vantora.faq.value | default: source %}
{% endif %}

<div class="vantora-faq" {{ block.shopify_attributes }}>
  {% if source.heading != blank %}
    <h3 class="vantora-faq__heading">{{ source.heading }}</h3>
  {% endif %}

  <div class="vantora-faq__list">
    {% for i in (1..8) %}
      {% assign q_key = 'question_' | append: i %}
      {% assign a_key = 'answer_' | append: i %}
      {% assign question = source[q_key] %}
      {% assign answer = source[a_key] %}
      {% if question != blank and answer != blank %}
        <details class="vantora-faq__item">
          <summary class="vantora-faq__question">{{ question }}</summary>
          <div class="vantora-faq__answer">{{ answer }}</div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .vantora-faq { padding: 16px 0; }
  .vantora-faq__heading { margin: 0 0 12px; }
  .vantora-faq__item { border-bottom: 1px solid rgba(0,0,0,.08); padding: 10px 0; }
  .vantora-faq__question { cursor: pointer; font-weight: 600; }
  .vantora-faq__answer { margin-top: 8px; font-size: 14px; color: rgba(0,0,0,.7); }
</style>

<script src="{{ 'vantora-analytics.js' | asset_url }}" defer></script>
<script>
  if (window.VantoraAnalytics) VantoraAnalytics.report('impression', 'faq');
</script>

{% comment %} FAQPage structured data for SEO {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% assign first = true %}
    {% for i in (1..8) %}
      {% assign q_key = 'question_' | append: i %}
      {% assign a_key = 'answer_' | append: i %}
      {% assign question = source[q_key] %}
      {% assign answer = source[a_key] %}
      {% if question != blank and answer != blank %}
        {% unless first %},{% endunless %}
        {% assign first = false %}
        {
          "@type": "Question",
          "name": {{ question | strip_html | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ answer | strip_html | json }} }
        }
      {% endif %}
    {% endfor %}
  ]
}
</script>

{% schema %}
{
  "name": "Vantora: Product FAQ",
  "target": "section",
  "settings": [
    { "type": "paragraph", "content": "Questions and answers are set in the Vantora app (Storefront > Product FAQ), not here. This block just controls where the FAQ appears on the page." }
  ]
}
{% endschema %}
