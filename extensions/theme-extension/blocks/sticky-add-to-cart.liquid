{% comment %}
  F-11 Sticky Add to Cart (app embed). Appears via Theme editor > App embeds.
  Renders only on product pages.

  Deliberately does NOT reimplement add-to-cart: a merchant reported it
  "not working properly" (variant selection / price display edge cases,
  and getting the theme's own cart drawer to open reliably -- themes have
  no standard API for that, confirmed against shopify.dev). This is now a
  simple nudge -- image, product name, one button -- that scrolls the
  page to the theme's own real add-to-cart form/button on click and lets
  the theme handle the rest (variant selection, price, cart drawer,
  everything) exactly as it already does natively, with zero chance of
  disagreeing with it.

  All content/appearance settings are configured in the Vantora app
  (Storefront > Sticky Add to Cart), not here -- see the schema note
  below for why. Renders nothing until the merchant has configured and
  activated this in the app.
{% endcomment %}
{% assign v = shop.metafields.vantora.sticky_atc.value %}

{% if v and product %}
  {% assign position = v.position %}
  {% assign button_text = v.button_text %}
  {% assign background_color = v.background_color %}
  {% assign text_color = v.text_color %}
  {% assign show_image = v.show_image %}
  {% assign show_desktop = v.show_desktop %}
  {% assign show_mobile = v.show_mobile %}
  {% assign scroll_trigger = v.scroll_trigger %}
  <div
    id="vantora-sticky-atc"
    class="vantora-sticky-atc vantora-sticky-atc--{{ position }}"
    data-position="{{ position }}"
    data-scroll-trigger="{{ scroll_trigger }}"
    data-show-desktop="{{ show_desktop }}"
    data-show-mobile="{{ show_mobile }}"
    style="--vantora-atc-bg: {{ background_color }}; --vantora-atc-text: {{ text_color }}; display: none;"
    {{ block.shopify_attributes }}
  >
    {% if show_image %}
      <img
        class="vantora-sticky-atc__image"
        src="{{ product.featured_image | image_url: width: 80 }}"
        alt="{{ product.featured_image.alt | escape }}"
        width="40" height="40"
        loading="lazy"
      >
    {% endif %}

    <span class="vantora-sticky-atc__title">{{ product.title }}</span>

    <button type="button" class="vantora-sticky-atc__button">
      {{ button_text | default: 'Add to cart' }}
    </button>
  </div>

  <style>
    .vantora-sticky-atc {
      position: fixed;
      left: 0;
      right: 0;
      z-index: 400;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: var(--vantora-atc-bg, #111);
      color: var(--vantora-atc-text, #fff);
      box-shadow: 0 -2px 12px rgba(0,0,0,.12);
    }
    .vantora-sticky-atc--top { top: 0; }
    .vantora-sticky-atc--bottom { bottom: 0; }
    .vantora-sticky-atc__title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .vantora-sticky-atc__button {
      background: var(--vantora-atc-text, #fff);
      color: var(--vantora-atc-bg, #111);
      border: 0; border-radius: 6px; padding: 10px 18px; cursor: pointer; font-weight: 600;
    }
    @media (max-width: 749px) {
      .vantora-sticky-atc[data-show-mobile="false"] { display: none !important; }
    }
    @media (min-width: 750px) {
      .vantora-sticky-atc[data-show-desktop="false"] { display: none !important; }
    }
  </style>

  <script src="{{ 'vantora-analytics.js' | asset_url }}" defer></script>
  <script>
    (function () {
      var bar = document.getElementById('vantora-sticky-atc');
      if (!bar) return;

      if (window.VantoraAnalytics) VantoraAnalytics.report('impression', 'sticky_atc');

      var trigger = bar.dataset.scrollTrigger === 'true';
      var atcForm = document.querySelector('form[action^="/cart/add"]');

      function reveal() {
        bar.style.display = 'flex';
      }

      if (!trigger) {
        reveal();
      } else if (atcForm && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            bar.style.display = entry.isIntersecting ? 'none' : 'flex';
          });
        }, { threshold: 0 });
        observer.observe(atcForm);
      } else {
        reveal();
      }

      bar.querySelector('.vantora-sticky-atc__button').addEventListener('click', function () {
        if (window.VantoraAnalytics) VantoraAnalytics.report('click', 'sticky_atc');
        if (!atcForm) return;
        var target = atcForm.querySelector('[type="submit"], button') || atcForm;
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Vantora: Sticky ATC",
  "target": "body",
  "settings": [
    { "type": "paragraph", "content": "Configured in the Vantora app (Storefront > Sticky Add to Cart). This embed just needs to be switched on here." }
  ]
}
{% endschema %}
