{% comment %}
  F-13 Trust Badges (app block). Merchant adds this block to the product
  or cart section via the theme editor.

  All content/appearance settings (layout, badges, icons) are configured
  in the Vantora app (Storefront > Trust Badges), not here -- see
  sticky-add-to-cart.liquid for why. Settings resolve in order: a
  product-specific `vantora` metafield (targeted to specific products in
  the app), then the shop-wide one (untargeted / everywhere). Renders
  nothing until the merchant has configured and activated this in the app.
{% endcomment %}
{% assign v = shop.metafields.vantora.trust_badges.value %}
{% if product %}
  {% assign product_v = product.metafields.vantora.trust_badges.value %}
  {% if product_v %}
    {% assign v = product_v %}
  {% endif %}
{% endif %}

{% if v %}
{% assign layout = v.layout %}

<div class="vantora-trust-badges vantora-trust-badges--{{ layout }}" {{ block.shopify_attributes }}>
  {% for i in (1..6) %}
    {% assign icon_key = 'badge_' | append: i | append: '_icon' %}
    {% assign label_key = 'badge_' | append: i | append: '_label' %}
    {% assign label = v[label_key] %}
    {% assign icon_name = v[icon_key] %}

    {% if label != blank %}
      <div class="vantora-trust-badges__item">
        {% if icon_name != blank %}
          <span class="vantora-trust-badges__icon" aria-hidden="true">
            {% case icon_name %}
              {% when 'shield' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 20 6 V12 C20 17 16.5 20.5 12 22 C7.5 20.5 4 17 4 12 V6 Z"/></svg>
              {% when 'lock' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11 V7 a4 4 0 0 1 8 0 v4"/></svg>
              {% when 'truck' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="14" height="10"/><path d="M15 10h4l3 3v3h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="18" cy="19" r="1.6"/></svg>
              {% when 'refresh' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
              {% when 'check' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {% when 'star' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 15 9 22 9.5 17 14.5 18.5 21.5 12 17.8 5.5 21.5 7 14.5 2 9.5 9 9 Z"/></svg>
              {% when 'card' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              {% when 'support' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 1 16 0"/><rect x="2" y="13" width="4" height="7" rx="1.5"/><rect x="18" y="13" width="4" height="7" rx="1.5"/></svg>
            {% endcase %}
          </span>
        {% endif %}
        <span>{{ label }}</span>
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
  .vantora-trust-badges { display: flex; flex-wrap: wrap; gap: 16px; padding: 12px 0; }
  .vantora-trust-badges--stacked { flex-direction: column; }
  .vantora-trust-badges__item { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .vantora-trust-badges__icon { display: inline-flex; flex-shrink: 0; }
</style>

<script src="{{ 'vantora-analytics.js' | asset_url }}" defer></script>
<script>
  if (window.VantoraAnalytics) VantoraAnalytics.report('impression', 'trust_badges');
</script>
{% endif %}

{% schema %}
{
  "name": "Vantora: Trust Badges",
  "target": "section",
  "settings": [
    { "type": "paragraph", "content": "Layout, badges and icons are set in the Vantora app (Storefront > Trust Badges), not here." }
  ]
}
{% endschema %}
